# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose. Used by cron + admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where the Supabase project physically lives. Surfaced verbatim in the app
# and in the data export, so keep it truthful. See src/lib/residency.ts.
NEXT_PUBLIC_SUPABASE_REGION=eu-central-1

# --- Anthropic (document extraction) ---
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-5-20250929

# --- Resend (email alerts) ---
RESEND_API_KEY=
ALERT_FROM_EMAIL="Sanad <alerts@example.com>"

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe price id per tier (see src/lib/plans.ts):
#   Starter      AED 149/mo   1 entity    50 documents
#   Growth       AED 399/mo   1 entity   250 documents
#   Multi-entity AED 999/mo  10 entities 2000 documents
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_MULTI_ENTITY=

# --- Cron & alert links ---
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
# Signs the tokenised Acknowledge / Mark-renewed links in alert emails.
# Kept separate from CRON_SECRET because rotating it invalidates every link
# in every reminder already sitting in someone's inbox.
# Falls back to CRON_SECRET if unset.
ALERT_LINK_SECRET=
